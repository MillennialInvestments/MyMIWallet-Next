//@version=6
indicator("MyMI Options Swing Contract Tracker v7", overlay=true, precision=2, max_labels_count=500, max_lines_count=500)

// =============================================================================
// MyMI Options Swing v7 — Advisory Integration & Trade Momentum Tracker
//
// Status: Source-ready advisory script for TradingView.
// Governed Rules:
// - Independent Call & Put contract counts (unequal sizing supported).
// - Entry capital = multiplier * (call_contracts * call_debit + put_contracts * put_debit) + fees.
// - Theoretical expiration targets derived from total position outlay & net profit objective.
// - Confirmed swing structure (BOS, BRK, PB, HL/LH, early-reversal, momentum-fade).
// - Pivots confirmed pivotRight bars after turning bar; labels NOT backdated.
// - Daily bias uses last completed daily bar (no lookahead / intra-day leak).
// - No fabricated option bids or simulated P&L. Manual bid snapshot explicitly labeled.
// - No secrets in source or alert payloads. Webhook events disabled by default.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. POSITION & CONTRACT INPUTS
// -----------------------------------------------------------------------------
var string GRP_POS = "Options Position & Contracts (v7 Independent Sizing)"
callContracts    = input.int(1, "Number of CALL Contracts", group=GRP_POS, minval=0, tooltip="Independent number of Call contracts purchased (e.g. 1, 2, 3)")
putContracts     = input.int(1, "Number of PUT Contracts", group=GRP_POS, minval=0, tooltip="Independent number of Put contracts purchased (e.g. 1, 2, 3)")
callEntryDebit   = input.float(0.95, "CALL Entry Debit ($/share)", group=GRP_POS, minval=0.01, step=0.05, tooltip="Per-contract entry debit for the Call leg")
putEntryDebit    = input.float(0.95, "PUT Entry Debit ($/share)", group=GRP_POS, minval=0.01, step=0.05, tooltip="Per-contract entry debit for the Put leg")
contractMult     = input.int(100, "Contract Multiplier (Shares)", group=GRP_POS, minval=1)
entryFeesTotal   = input.float(0.0, "Total Entry Fees & Comm ($)", group=GRP_POS, minval=0.0, step=0.50)
targetNetProfit  = input.float(200.0, "Target Net Profit ($)", group=GRP_POS, step=25.0, tooltip="Desired net profit above full position outlay")
callStrike       = input.float(105.0, "CALL Strike ($)", group=GRP_POS, step=0.50, tooltip="Strike price of the Call leg from option chain")
putStrike        = input.float(95.0, "PUT Strike ($)", group=GRP_POS, step=0.50, tooltip="Strike price of the Put leg from option chain")
expiryLabel      = input.string("Weekly Expiry", "Expiry Label / Date", group=GRP_POS)

var string GRP_SNAP = "Optional Manual Bid Snapshot (Explicit Mark, Not Live Feed)"
useManualSnapshot = input.bool(false, "Show Manual Bid Snapshot in Dashboard", group=GRP_SNAP, tooltip="Displays static snapshot values. Does not simulate broker executions.")
manualCallBid     = input.float(0.95, "Manual CALL Bid Snapshot ($)", group=GRP_SNAP, step=0.05)
manualPutBid      = input.float(0.95, "Manual PUT Bid Snapshot ($)", group=GRP_SNAP, step=0.05)

var string GRP_SWING = "Swing Structure & Technical Filters"
pivotLeft        = input.int(5, "Pivot Left Bars", group=GRP_SWING, minval=1)
pivotRight       = input.int(3, "Pivot Right Bars (Confirmation Delay)", group=GRP_SWING, minval=1, tooltip="Pivots confirm exactly this many bars after the extreme; labels are plotted at confirmation bar, not backdated.")
showSwingLabels  = input.bool(true, "Show Structural Swing Labels (BOS, BRK, PB, HL/LH)", group=GRP_SWING)
showTargets      = input.bool(true, "Plot Expiration Target Levels on Chart", group=GRP_SWING)
showDashboard    = input.bool(true, "Show Position Summary Table", group=GRP_SWING)
colorBarsFlow    = input.bool(true, "Color Bars by Momentum Flow", group=GRP_SWING)
rvolThreshold    = input.float(1.3, "RVOL Breakout Threshold", group=GRP_SWING, step=0.1)

var string GRP_HOOK = "Ingress & Alert Integration"
enableWebhook    = input.bool(false, "Enable alert() Webhook Events (Default: OFF)", group=GRP_HOOK, tooltip="Keep OFF until authenticated ingress and rate limits are certified.")
tradeUuid        = input.string("", "MyMI Position Trade UUID (Optional)", group=GRP_HOOK, tooltip="Exact trade UUID from MyMI position engine. Do not enter credentials.")

// -----------------------------------------------------------------------------
// 2. POSITION ECONOMICS & THEORETICAL EXPIRATION TARGETS
// -----------------------------------------------------------------------------
// Total Outlay = Multiplier * (Call_Contracts * Call_Debit + Put_Contracts * Put_Debit) + Fees
callOutlay = callContracts * callEntryDebit * contractMult
putOutlay  = putContracts  * putEntryDebit  * contractMult
totalOutlay = callOutlay + putOutlay + entryFeesTotal
targetLiquidationProceeds = totalOutlay + targetNetProfit

// Theoretical Expiration Stock Targets:
// Call Target: Strike + (Target Liquidation / (Call_Contracts * Multiplier))
// Put Target:  Strike - (Target Liquidation / (Put_Contracts * Multiplier))
callTargetStockPrice = callContracts > 0 ? (callStrike + (targetLiquidationProceeds / (callContracts * contractMult))) : na
putTargetStockPrice  = putContracts  > 0 ? (putStrike  - (targetLiquidationProceeds / (putContracts  * contractMult))) : na

// -----------------------------------------------------------------------------
// 3. DAILY BIAS & MULTI-TIMEFRAME CONTEXT (NO DEVELOPING BAR LEAK)
// -----------------------------------------------------------------------------
// Access previous completed daily bar to avoid leaking developing daily bar into intraday historical labels
dailyClosePrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
dailyOpenPrev  = request.security(syminfo.tickerid, "D", open[1], barmerge.gaps_off, barmerge.lookahead_off)
dailyBiasBull  = not na(dailyClosePrev) and not na(dailyOpenPrev) and (dailyClosePrev >= dailyOpenPrev)

// -----------------------------------------------------------------------------
// 4. MOMENTUM INDICATORS & VOLUME ACCELERATION
// -----------------------------------------------------------------------------
fastEma = ta.ema(close, 9)
slowEma = ta.ema(close, 21)
baseEma = ta.ema(close, 55)
atrVal  = ta.atr(14)
vwapVal = ta.vwap(close)

volSma20 = ta.sma(volume, 20)
rvol     = volSma20 > 0 ? (volume / volSma20) : 1.0

volSma5   = ta.sma(volume, 5)
volAccel5 = volSma5 > 0 ? (volume / volSma5) : 1.0

// Velocity & Momentum Direction
velocity = ta.ema(ta.roc(close, 3), 3)
momentumBull = (fastEma > slowEma) and (close > vwapVal) and (velocity > 0)
momentumBear = (fastEma < slowEma) and (close < vwapVal) and (velocity < 0)
momentumFade = (ta.crossunder(fastEma, slowEma) and velocity < 0) or (ta.crossover(fastEma, slowEma) and velocity > 0)

// -----------------------------------------------------------------------------
// 5. CONFIRMED SWING STRUCTURE (UN-BACKDATED LABELS)
// -----------------------------------------------------------------------------
// Pivots confirm pivotRight bars after the turning bar
pHi = ta.pivothigh(high, pivotLeft, pivotRight)
pLo = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh = na
var float prevSwingHigh = na
var float lastSwingLow  = na
var float prevSwingLow  = na

var int lastSwingHighBar = na
var int lastSwingLowBar  = na

isNewHighPivot = not na(pHi)
isNewLowPivot  = not na(pLo)

if isNewHighPivot
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := pHi
    lastSwingHighBar := bar_index - pivotRight

if isNewLowPivot
    prevSwingLow := lastSwingLow
    lastSwingLow := pLo
    lastSwingLowBar := bar_index - pivotRight

// Break of Structure (BOS): confirmed bar close exceeding prior confirmed swing
bosBullish = not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bosBearish = not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)

// Breakout (BRK): fast momentum breakout with accelerating RVOL
breakoutLong  = bosBullish and (rvol >= rvolThreshold)
breakoutShort = bosBearish and (rvol >= rvolThreshold)

// Pullback (PB): retest of 21 EMA in direction of prevailing structure
pullbackLong  = (close > baseEma) and ta.crossunder(low, slowEma) and (close > slowEma)
pullbackShort = (close < baseEma) and ta.crossover(high, slowEma) and (close < slowEma)

// Higher Low / Lower High Confirmation at Pivot Bar (Plotted at CURRENT bar upon confirmation)
hlConfirmed = isNewLowPivot and not na(prevSwingLow) and (lastSwingLow > prevSwingLow)
lhConfirmed = isNewHighPivot and not na(prevSwingHigh) and (lastSwingHigh < prevSwingHigh)

// Early Reversal Warning: lower-confidence divergence near 2.0 ATR bands
upperBand = vwapVal + (2.0 * atrVal)
lowerBand = vwapVal - (2.0 * atrVal)
earlyReversalBear = (high >= upperBand) and (close < open) and (rvol > 1.2)
earlyReversalBull = (low <= lowerBand) and (close > open) and (rvol > 1.2)

// -----------------------------------------------------------------------------
// 6. VISUAL RENDERING & CHART LABELS
// -----------------------------------------------------------------------------
// EMAs
plot(fastEma, "Fast 9 EMA", color=color.new(#00E676, 30), linewidth=1)
plot(slowEma, "Slow 21 EMA", color=color.new(#FF9800, 30), linewidth=1)
plot(baseEma, "Base 55 EMA", color=color.new(#2979FF, 20), linewidth=2)
plot(vwapVal, "Session VWAP", color=color.new(#E040FB, 30), linewidth=1)

// Expiration Target Stock Levels
plot(showTargets ? callTargetStockPrice : na, "Call Target Stock Price (Expiration)", color=color.new(#00C853, 0), linewidth=2, style=plot.style_linebr)
plot(showTargets ? putTargetStockPrice : na, "Put Target Stock Price (Expiration)", color=color.new(#D50000, 0), linewidth=2, style=plot.style_linebr)
plot(showTargets ? callStrike : na, "Call Strike", color=color.new(#00C853, 50), linewidth=1, style=plot.style_circles)
plot(showTargets ? putStrike : na, "Put Strike", color=color.new(#D50000, 50), linewidth=1, style=plot.style_circles)

// Color Bars by Momentum Flow
barcolor(colorBarsFlow ? (momentumBull ? #00E676 : (momentumBear ? #FF1744 : (momentumFade ? #FFD600 : #9E9E9E))) : na)

// Un-backdated Structural Labels (Plotted at current confirmation bar)
if showSwingLabels
    if breakoutLong
        label.new(bar_index, high, "BRK ▲\n(RVOL " + str.tostring(rvol, "#.1") + ")", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
    else if bosBullish
        label.new(bar_index, high, "BOS ▲", color=color.teal, textcolor=color.white, style=label.style_label_down, size=size.tiny)

    if breakoutShort
        label.new(bar_index, low, "BRK ▼\n(RVOL " + str.tostring(rvol, "#.1") + ")", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.small)
    else if bosBearish
        label.new(bar_index, low, "BOS ▼", color=color.maroon, textcolor=color.white, style=label.style_label_up, size=size.tiny)

    if hlConfirmed
        label.new(bar_index, low, "HL (Conf)", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    if lhConfirmed
        label.new(bar_index, high, "LH (Conf)", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.tiny)

    if pullbackLong
        label.new(bar_index, low, "PB ▲", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=size.tiny)
    if pullbackShort
        label.new(bar_index, high, "PB ▼", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)

    if earlyReversalBear
        label.new(bar_index, high, "Early Rev ▼\n(Low Conf)", color=color.new(color.purple, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)
    if earlyReversalBull
        label.new(bar_index, low, "Early Rev ▲\n(Low Conf)", color=color.new(color.purple, 20), textcolor=color.white, style=label.style_label_up, size=size.tiny)

// -----------------------------------------------------------------------------
// 7. POSITION & TARGET LIQUIDATION DASHBOARD TABLE
// -----------------------------------------------------------------------------
var table dash = table.new(position.top_right, 4, 10, bgcolor=color.new(#1E222D, 10), border_color=color.new(#374151, 30), border_width=1)

if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "MyMI Options Swing v7", bgcolor=#1E3A8A, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker, bgcolor=#1E3A8A, text_color=color.yellow, text_size=size.small)
    table.cell(dash, 2, 0, "Daily Bias:", bgcolor=#1E3A8A, text_color=color.white, text_size=size.small)
    table.cell(dash, 3, 0, dailyBiasBull ? "BULLISH ▲" : "BEARISH ▼", bgcolor=#1E3A8A, text_color=dailyBiasBull ? color.green : color.red, text_size=size.small)

    table.cell(dash, 0, 1, "Position Sizing", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(callContracts) + "C / " + str.tostring(putContracts) + "P", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 1, "Expiry:", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 3, 1, expiryLabel, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 2, "Entry Debits", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, "C: $" + str.tostring(callEntryDebit, "#.2f") + " | P: $" + str.tostring(putEntryDebit, "#.2f"), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 2, 2, "Multiplier:", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 3, 2, str.tostring(contractMult), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 3, "Total Outlay (Capital)", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, "$" + str.tostring(totalOutlay, "#.2f"), text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 2, 3, "Net Target:", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 3, 3, "+$" + str.tostring(targetNetProfit, "#.2f"), text_color=color.green, text_size=size.tiny)

    table.cell(dash, 0, 4, "Target Liquidation Proceeds", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, "$" + str.tostring(targetLiquidationProceeds, "#.2f"), text_color=color.yellow, text_size=size.tiny)
    table.cell(dash, 2, 4, "Current RVOL:", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 3, 4, str.tostring(rvol, "#.2f") + "x", text_color=rvol >= 1.3 ? color.green : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 5, "Call Strike / Target Stock", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, "$" + str.tostring(callStrike, "#.2f") + " → $" + str.tostring(callTargetStockPrice, "#.2f"), text_color=color.green, text_size=size.tiny)
    table.cell(dash, 2, 5, "Put Strike / Target Stock", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 3, 5, "$" + str.tostring(putStrike, "#.2f") + " → $" + str.tostring(putTargetStockPrice, "#.2f"), text_color=color.red, text_size=size.tiny)

    if useManualSnapshot
        manualTotalValue = (callContracts * manualCallBid * contractMult) + (putContracts * manualPutBid * contractMult)
        manualNetPnl = manualTotalValue - totalOutlay
        table.cell(dash, 0, 6, "MANUAL SNAPSHOT BID", bgcolor=#374151, text_color=color.yellow, text_size=size.tiny)
        table.cell(dash, 1, 6, "C: $" + str.tostring(manualCallBid, "#.2f") + " | P: $" + str.tostring(manualPutBid, "#.2f"), bgcolor=#374151, text_color=color.white, text_size=size.tiny)
        table.cell(dash, 2, 6, "Snapshot P&L:", bgcolor=#374151, text_color=color.yellow, text_size=size.tiny)
        table.cell(dash, 3, 6, (manualNetPnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(manualNetPnl), "#.2f"), bgcolor=#374151, text_color=manualNetPnl >= targetNetProfit ? color.green : color.white, text_size=size.tiny)

// -----------------------------------------------------------------------------
// 8. STRUCTURED ALERT EMISSION (JSON SIGNAL ONLY, NO SECRETS)
// -----------------------------------------------------------------------------
emitAlert(string signalName, string note) =>
    if enableWebhook
        alertMsg = "{\"source\":\"tradingview\",\"version\":\"v7\",\"ticker\":\"" + syminfo.ticker + "\",\"trade_uuid\":\"" + tradeUuid + "\",\"signal\":\"" + signalName + "\",\"timeframe\":\"" + timeframe.period + "\",\"price\":" + str.tostring(close, "#.4f") + ",\"rvol\":" + str.tostring(rvol, "#.2f") + ",\"note\":\"" + note + "\"}"
        alert(alertMsg, alert.freq_once_per_bar_close)

if breakoutLong
    emitAlert("breakout_long", "Bullish breakout with volume expansion")
if breakoutShort
    emitAlert("breakout_short", "Bearish breakout with volume expansion")
if bosBullish
    emitAlert("bos_bullish", "Break of structure to the upside")
if bosBearish
    emitAlert("bos_bearish", "Break of structure to the downside")
if momentumFade
    emitAlert("momentum_fade", "Momentum deceleration detected")
