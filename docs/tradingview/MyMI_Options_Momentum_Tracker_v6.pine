//@version=6
indicator("MyMI Options Opportunity & Trade Momentum Tracker v6", overlay=true, precision=2)

// =========================================================================
// 1. INPUT CONFIGURATION (VARIABLE STRATEGY & BALANCE SETTINGS)
// =========================================================================
var string GRP_OPT = "Weekly Options Strategy & Position"
strategyStructure   = input.string("OTM Strangle (Recommended)", "Strategy Structure", options=["OTM Strangle (Recommended)", "ATM Straddle", "Custom Strikes"], group=GRP_OPT)
otmOffsetPct        = input.float(4.0, "Auto OTM Strike Distance (%)", group=GRP_OPT, step=0.5, tooltip="For OTM Strangle: % above market for Call strike, % below for Put strike")
callStrikeInput     = input.float(0.0, "Manual Call Strike (used if > 0)", group=GRP_OPT, step=0.5, tooltip="E.g. $210 for a $200 stock")
putStrikeInput      = input.float(0.0, "Manual Put Strike (used if > 0)", group=GRP_OPT, step=0.5, tooltip="E.g. $150 or $190 for a $200 stock")
strikeInterval      = input.float(0.0, "Strike Step/Interval (0 = Auto: $0.5, $1, $5)", group=GRP_OPT, step=0.5)

targetBalanceCall   = input.float(100.0, "Call Target Entry Balance ($)", group=GRP_OPT, step=10.0)
targetBalancePut    = input.float(100.0, "Put Target Entry Balance ($)", group=GRP_OPT, step=10.0)
entryDebitCall      = input.float(0.95, "Call Leg Entry Debit ($)", group=GRP_OPT, step=0.05)
entryDebitPut       = input.float(0.95, "Put Leg Entry Debit ($)", group=GRP_OPT, step=0.05)
targetNetProfit     = input.float(200.0, "Target Net Profit ($)", group=GRP_OPT, step=25.0)
sizingMode          = input.string("Target Balance ($100/leg)", "Position Sizing Mode", options=["Target Balance ($100/leg)", "Fixed Contract Pairs"], group=GRP_OPT)
contractPairs       = input.int(1, "Fixed Contract Pairs (if Fixed mode)", group=GRP_OPT, minval=1)
entryPriceStock     = input.float(0.0, "Entry Stock Price (0 = Auto Session Open / Current)", group=GRP_OPT)
enableWebhookAlerts = input.bool(true, "Enable Structured Webhook Alerts", group=GRP_OPT)
webhookSecret       = input.string("mymi-options-secure-key", "Webhook Secret / Bearer Token", group=GRP_OPT)

var string GRP_MOM  = "Momentum & Volume Acceleration"
rvolThreshold       = input.float(1.5, "RVOL Warning Trigger Level", group=GRP_MOM, step=0.1)
trailRetracePct     = input.float(25.0, "Peak Profit Trailing Retrace Warning (%)", group=GRP_MOM, step=5.0)
fastEmaLen          = input.int(9, "Fast EMA Length", group=GRP_MOM)
slowEmaLen          = input.int(21, "Slow EMA Length", group=GRP_MOM)
baselineEmaLen      = input.int(55, "Baseline EMA Length", group=GRP_MOM)

// =========================================================================
// 2. CORE MOMENTUM & VOLUME ACCELERATION CALCULATIONS
// =========================================================================
fastEma  = ta.ema(close, fastEmaLen)
slowEma  = ta.ema(close, slowEmaLen)
baseEma  = ta.ema(close, baselineEmaLen)
vwapVal  = ta.vwap(close)
atr14    = ta.atr(14)
volSma20 = ta.sma(volume, 20)
rvol     = volSma20 > 0 ? (volume / volSma20) : 1.0

volRate5  = ta.sma(volume, 5)
volAccel5 = volRate5 > 0 ? (volume / volRate5) : 1.0

deltaPrice = math.abs(close - close[1])
sharesInMillions = math.max(0.01, volume / 1000000.0)
dispEfficiency = deltaPrice / sharesInMillions
velocity = ta.ema(ta.roc(close, 3), 3)

// =========================================================================
// 3. STRIKES & TARGET BALANCE ENTRY POSITION MODELING
// =========================================================================
// Entry Price Anchor (explicit input, session open, or first bar)
sessionOpen = ta.valuewhen(ta.change(time("D")) != 0, open, 0)
effectiveEntryPrice = entryPriceStock > 0 ? entryPriceStock : (na(sessionOpen) ? close : sessionOpen)

// Strike Step Size
autoStep = effectiveEntryPrice > 250.0 ? 5.0 : (effectiveEntryPrice > 50.0 ? 1.0 : 0.5)
stepSize = strikeInterval > 0 ? strikeInterval : autoStep

// Compute Strikes based on strategy structure
float calcCallStrike = 0.0
float calcPutStrike  = 0.0

if strategyStructure == "Custom Strikes" or (callStrikeInput > 0 and putStrikeInput > 0)
    calcCallStrike := callStrikeInput > 0 ? callStrikeInput : math.round((effectiveEntryPrice * (1.0 + (otmOffsetPct / 100.0))) / stepSize) * stepSize
    calcPutStrike  := putStrikeInput > 0  ? putStrikeInput  : math.round((effectiveEntryPrice * (1.0 - (otmOffsetPct / 100.0))) / stepSize) * stepSize
else if strategyStructure == "ATM Straddle"
    atmBase = math.round(effectiveEntryPrice / stepSize) * stepSize
    calcCallStrike := callStrikeInput > 0 ? callStrikeInput : atmBase
    calcPutStrike  := putStrikeInput > 0  ? putStrikeInput  : atmBase
else
    // Default: OTM Strangle (Call ABOVE price e.g. $210, Put BELOW price e.g. $190 or $150)
    rawCall = effectiveEntryPrice * (1.0 + (otmOffsetPct / 100.0))
    rawPut  = effectiveEntryPrice * (1.0 - (otmOffsetPct / 100.0))
    calcCallStrike := callStrikeInput > 0 ? callStrikeInput : math.round(rawCall / stepSize) * stepSize
    calcPutStrike  := putStrikeInput > 0  ? putStrikeInput  : math.round(rawPut  / stepSize) * stepSize

// Position sizing by target balance ($100 Call / $100 Put default) or fixed contracts
int contractsCall = 1
int contractsPut  = 1
float actualOutlayCall = 0.0
float actualOutlayPut  = 0.0

if sizingMode == "Target Balance ($100/leg)"
    // Sizing: contracts = Target Balance / (Debit * 100)
    contractsCall := math.max(1, math.round(targetBalanceCall / (entryDebitCall * 100.0)))
    contractsPut  := math.max(1, math.round(targetBalancePut / (entryDebitPut * 100.0)))
    actualOutlayCall := contractsCall * entryDebitCall * 100.0
    actualOutlayPut  := contractsPut * entryDebitPut * 100.0
else
    contractsCall := contractPairs
    contractsPut  := contractPairs
    actualOutlayCall := contractsCall * entryDebitCall * 100.0
    actualOutlayPut  := contractsPut * entryDebitPut * 100.0

float totalTargetBalance   = targetBalanceCall + targetBalancePut // e.g. $200.00 target allocation
float totalInvested        = actualOutlayCall + actualOutlayPut   // e.g. $190.00 actual capital deployed
float combinedEntryDebit   = entryDebitCall + entryDebitPut       // e.g. $1.90 combined debit per pair
float maxContracts         = math.max(contractsCall, contractsPut)
float requiredExitPerPair  = combinedEntryDebit + (targetNetProfit / (100.0 * maxContracts)) // e.g. $3.90

// =========================================================================
// Real-time Option Leg Valuation Relative to Entry & OTM Strikes
// =========================================================================
stockMove  = close - effectiveEntryPrice
distToCall = math.max(0.5, calcCallStrike - effectiveEntryPrice)
distToPut  = math.max(0.5, effectiveEntryPrice - calcPutStrike)

float estCallVal = entryDebitCall
float estPutVal  = entryDebitPut

if stockMove > 0
    // Stock is rallying UP towards / beyond Call Strike
    coverageCall = stockMove / distToCall
    callDelta = coverageCall < 1.0 ? (0.28 + (0.22 * coverageCall)) : math.min(0.95, 0.50 + (0.45 * math.min(1.0, (stockMove - distToCall) / math.max(1.0, atr14 * 2.0))))
    estCallVal := math.max(entryDebitCall * 0.10, entryDebitCall + (stockMove * callDelta))
    if close > calcCallStrike
        estCallVal := math.max(estCallVal, (close - calcCallStrike) + (entryDebitCall * 0.50))
    // Put decays as price moves away
    estPutVal := math.max(0.02, entryDebitPut - (stockMove * 0.10))
else if stockMove < 0
    // Stock is dumping DOWN towards / beyond Put Strike
    downMove = math.abs(stockMove)
    coveragePut = downMove / distToPut
    putDelta = coveragePut < 1.0 ? (0.28 + (0.22 * coveragePut)) : math.min(0.95, 0.50 + (0.45 * math.min(1.0, (downMove - distToPut) / math.max(1.0, atr14 * 2.0))))
    estPutVal := math.max(entryDebitPut * 0.10, entryDebitPut + (downMove * putDelta))
    if close < calcPutStrike
        estPutVal := math.max(estPutVal, (calcPutStrike - close) + (entryDebitPut * 0.50))
    // Call decays as price moves away
    estCallVal := math.max(0.02, entryDebitCall - (downMove * 0.10))
else
    estCallVal := entryDebitCall
    estPutVal  := entryDebitPut

estCombinedBid = estCallVal + estPutVal
estTotalValue = (estCallVal * 100.0 * contractsCall) + (estPutVal * 100.0 * contractsPut)
unrealizedPnl = estTotalValue - totalInvested

// High water mark / Peak unrealized P&L
var float peakPnl = 0.0
peakPnl := math.max(peakPnl, unrealizedPnl)

// =========================================================================
// 4. ACTIONABLE EXIT, REVERSAL & WARNING TRIGGERS
// =========================================================================
targetReached = estCombinedBid >= requiredExitPerPair or unrealizedPnl >= targetNetProfit

prevailingLong   = close > effectiveEntryPrice
prevailingShort  = close < effectiveEntryPrice
momentumFading   = (prevailingLong and ta.crossunder(close, fastEma)) or (prevailingShort and ta.crossover(close, fastEma)) or (rvol < 0.9 and math.abs(velocity) < 0.2)
warnMomentumFade = momentumFading and unrealizedPnl > 50.0 and not targetReached

warnPeakDrawdown = peakPnl >= 100.0 and (unrealizedPnl < (peakPnl * (1.0 - (trailRetracePct / 100.0)))) and unrealizedPnl > 0.0

// =========================================================================
// 5. VISUALIZATION OVERLAYS & STRIKE LEVELS
// =========================================================================
plot(fastEma, "Fast EMA (9)", color=color.new(color.teal, 0), linewidth=1)
plot(slowEma, "Slow EMA (21)", color=color.new(color.orange, 0), linewidth=1)
plot(baseEma, "Baseline EMA (55)", color=color.new(color.blue, 20), linewidth=2)
plot(vwapVal, "Session VWAP", color=color.new(color.purple, 10), linewidth=2)

// Horizontal Strike Level Plots
plot(calcCallStrike, "Call Strike Level", color=color.new(color.teal, 20), linewidth=2, style=plot.style_linebr)
plot(calcPutStrike,  "Put Strike Level",  color=color.new(color.maroon, 20), linewidth=2, style=plot.style_linebr)
plot(effectiveEntryPrice, "Entry Anchor Price", color=color.new(color.silver, 50), linewidth=1, style=plot.style_circles)

// Signal Shapes
plotshape(targetReached and not targetReached[1], "Target Reached ($200 Net)", shape.labelup, location.belowbar, color=color.green, text="TARGET\n+$200", textcolor=color.white, size=size.normal)
plotshape(warnMomentumFade and not warnMomentumFade[1], "Momentum Weakening Warning", shape.triangledown, location.abovebar, color=color.yellow, text="MOM FADE", textcolor=color.black, size=size.small)
plotshape(warnPeakDrawdown and not warnPeakDrawdown[1], "Peak Trailing Warning", shape.flag, location.abovebar, color=color.red, text="PEAK DROP", textcolor=color.white, size=size.small)

// Dashboard Table
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
if barstate.islast
    string stratLabel = strategyStructure == "ATM Straddle" ? "MyMI Straddle" : "MyMI Strangle (OTM)"
    table.cell(dash, 0, 0, stratLabel, bgcolor=color.blue, text_color=color.white)
    table.cell(dash, 1, 0, syminfo.ticker + " ($" + str.tostring(close, "#.##") + ")", bgcolor=color.blue, text_color=color.white)
    
    table.cell(dash, 0, 1, "Call / Put Strikes", text_color=color.silver)
    table.cell(dash, 1, 1, "C: $" + str.tostring(calcCallStrike, "#.##") + " / P: $" + str.tostring(calcPutStrike, "#.##"), text_color=color.yellow)
    
    table.cell(dash, 0, 2, "Target Balance", text_color=color.silver)
    table.cell(dash, 1, 2, "$" + str.tostring(targetBalanceCall, "#") + " C / $" + str.tostring(targetBalancePut, "#") + " P ($" + str.tostring(totalTargetBalance, "#") + ")", text_color=color.white)
    
    table.cell(dash, 0, 3, "Capital Outlay", text_color=color.silver)
    table.cell(dash, 1, 3, "$" + str.tostring(totalInvested, "#.##") + " (" + str.tostring(contractsCall) + "C / " + str.tostring(contractsPut) + "P)", text_color=color.white)
    
    table.cell(dash, 0, 4, "Current Bid", text_color=color.silver)
    table.cell(dash, 1, 4, "$" + str.tostring(estCombinedBid, "#.##"), text_color=color.white)
    
    color pnlCol = unrealizedPnl >= targetNetProfit ? color.green : (unrealizedPnl > 0 ? color.teal : color.red)
    table.cell(dash, 0, 5, "Unrealized P&L", text_color=color.silver)
    table.cell(dash, 1, 5, (unrealizedPnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(unrealizedPnl), "#.##"), bgcolor=pnlCol, text_color=color.white)
    
    table.cell(dash, 0, 6, "Target Profit", text_color=color.silver)
    table.cell(dash, 1, 6, "+$" + str.tostring(targetNetProfit, "#.##") + " ($" + str.tostring(requiredExitPerPair, "#.##") + ")", text_color=color.green)
    
    table.cell(dash, 0, 7, "RVOL / Accel", text_color=color.silver)
    table.cell(dash, 1, 7, str.tostring(rvol, "#.##") + "x / " + str.tostring(volAccel5, "#.##") + "x", text_color=color.white)
    
    string statusText = targetReached ? "TARGET REACHED" : (warnPeakDrawdown ? "PEAK DRAWDOWN" : (warnMomentumFade ? "MOM WEAKENING" : "ACTIVE / HOLD"))
    color statusBg = targetReached ? color.green : (warnPeakDrawdown ? color.red : (warnMomentumFade ? color.yellow : color.teal))
    table.cell(dash, 0, 8, "Strategy Status", text_color=color.silver)
    table.cell(dash, 1, 8, statusText, bgcolor=statusBg, text_color=color.black)

// =========================================================================
// 6. STRUCTURED WEBHOOK ALERTS (DISPATCH TO MyMI WALLET)
// =========================================================================
if enableWebhookAlerts
    if targetReached and not targetReached[1]
        string jsonTarget = '{"secret":"' + webhookSecret + '","ticker":"' + syminfo.ticker + '","strategy":"' + strategyStructure + '","signal":"target_reached","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"call_strike":' + str.tostring(calcCallStrike) + ',"put_strike":' + str.tostring(calcPutStrike) + ',"target_balance_call":' + str.tostring(targetBalanceCall) + ',"target_balance_put":' + str.tostring(targetBalancePut) + ',"combined_bid":' + str.tostring(estCombinedBid) + ',"unrealized_pnl":' + str.tostring(unrealizedPnl) + ',"rvol":' + str.tostring(rvol) + ',"timestamp":"' + str.tostring(timenow) + '"}'
        alert(jsonTarget, alert.freq_once_per_bar_close)
        
    if warnMomentumFade and not warnMomentumFade[1]
        string jsonFade = '{"secret":"' + webhookSecret + '","ticker":"' + syminfo.ticker + '","strategy":"' + strategyStructure + '","signal":"momentum_weakening","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"call_strike":' + str.tostring(calcCallStrike) + ',"put_strike":' + str.tostring(calcPutStrike) + ',"target_balance_call":' + str.tostring(targetBalanceCall) + ',"target_balance_put":' + str.tostring(targetBalancePut) + ',"combined_bid":' + str.tostring(estCombinedBid) + ',"unrealized_pnl":' + str.tostring(unrealizedPnl) + ',"rvol":' + str.tostring(rvol) + ',"timestamp":"' + str.tostring(timenow) + '"}'
        alert(jsonFade, alert.freq_once_per_bar_close)

    if warnPeakDrawdown and not warnPeakDrawdown[1]
        string jsonDrawdown = '{"secret":"' + webhookSecret + '","ticker":"' + syminfo.ticker + '","strategy":"' + strategyStructure + '","signal":"peak_drawdown","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"call_strike":' + str.tostring(calcCallStrike) + ',"put_strike":' + str.tostring(calcPutStrike) + ',"target_balance_call":' + str.tostring(targetBalanceCall) + ',"target_balance_put":' + str.tostring(targetBalancePut) + ',"combined_bid":' + str.tostring(estCombinedBid) + ',"peak_pnl":' + str.tostring(peakPnl) + ',"unrealized_pnl":' + str.tostring(unrealizedPnl) + ',"timestamp":"' + str.tostring(timenow) + '"}'
        alert(jsonDrawdown, alert.freq_once_per_bar_close)
