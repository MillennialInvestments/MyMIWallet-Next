# -----------------------------
# Global Infrastructure Toggles
# -----------------------------
feature.infrastructure.enabled=false
feature.overlay.strict_mode=false

# Integrations
feature.integration.alphavantage=false
feature.integration.marketaux=false
feature.integration.coingecko=false
feature.integration.discord=false
feature.integration.zapier=false
feature.integration.imap=false
feature.integration.twilio=false

# AIOps / Chat / Python / Governance
feature.aiops.enabled=false
feature.chat.enabled=false
feature.python.enabled=false
feature.governance.enabled=false

# Logging / Debug / Security / Cron
feature.logging.enabled=true
feature.debug.enabled=false
feature.security.enabled=true
feature.cron.enabled=false

# -----------------------------
# Integration transport defaults
# -----------------------------
integration.http.timeout=12
integration.http.connect_timeout=5
integration.http.retry_attempts=3
integration.http.retry_backoff_ms=250
integration.rate_limit.window_seconds=60
integration.cache.ttl_seconds=120

integration.alphavantage.base_url=https://www.alphavantage.co
integration.alphavantage.api_key=
integration.alphavantage.rate_limit_per_minute=5

integration.marketaux.base_url=https://api.marketaux.com
integration.marketaux.api_token=
integration.marketaux.rate_limit_per_minute=10

integration.coingecko.base_url=https://api.coingecko.com/api/v3
integration.coingecko.api_key=
integration.coingecko.rate_limit_per_minute=20

integration.discord.webhook=
integration.zapier.webhook=

integration.imap.host=imap.dreamhost.com
integration.imap.port=993
integration.imap.user=
integration.imap.pass=
integration.imap.mailbox=INBOX

integration.twilio.account_sid=
integration.twilio.auth_token=
integration.twilio.from_number=

# -----------------------------
# Redis
# -----------------------------
redis.enabled=false
redis.host=127.0.0.1
redis.port=6379
redis.password=
redis.database=0

# -----------------------------
# Email (SMTP/IMAP)
# -----------------------------
email.smtp.host=smtp.dreamhost.com
email.smtp.port=587
email.smtp.user=
email.smtp.pass=
email.smtp.encryption=tls
email.from.address=
email.from.name=

# -----------------------------
# AIOps
# -----------------------------
aiops.enabled=false
aiops.discord.webhook=
aiops.github.token=
aiops.slack.webhook=

# -----------------------------
# Chat / Ollama / Python
# -----------------------------
chat.ollama.enabled=false
chat.ollama.base_url=http://127.0.0.1:11434
chat.ollama.model=llama3.1
python.runner.enabled=false
python.runner.bin=python3
python.runner.timeout_seconds=45

# -----------------------------
# Governance / Audits
# -----------------------------
governance.audit.enabled=false
governance.filesystem.enabled=false
governance.secrets_scan.enabled=false

# -----------------------------
# Logging / Debug / Security / Cron
# -----------------------------
logging.channel=stack
logging.level=warning
debug.toolbar.enabled=false
debug.profiler.enabled=false
security.strict_mode=true
security.content_security_policy=true
cron.enabled=false
cron.auth_key=
