# MyMI Wallet environment template
CI_ENVIRONMENT=production
CI_DEBUG=false

# Logging verbosity controls
# Safe default for production-like quiet mode.
LOG_THRESHOLD=emergency,alert,critical,error

# Uncomment for full-spectrum debugging (DEBUG -> EMERGENCY)
# LOG_THRESHOLD=emergency,alert,critical,error,warning,notice,info,debug

# Optional: include warning-level email notifications from DatabaseLoggerHandler
LOGGER_EMAIL_WARNING=false

# Emergency logging override (CLI/Web/AIOPS): forces all levels including debug/info
AIOPS_FORCE_DEBUG=false

# Centralized AIOPS orchestration endpoint (primary control plane)
# AIOPS_MODE: remote = centralized AIOPS health/status checks, local = legacy local runtime checks.
AIOPS_MODE=remote
AIOPS_BASE_URL=https://aiops.timothyburks.com
AIOPS_APP_KEY=mymiwallet
# Generate AIOPS_SHARED_SECRET per app with a cryptographically secure random generator (e.g. openssl rand -hex 32).
# Do NOT use keys:generate or keys:generate-ci4 for this secret.
AIOPS_SHARED_SECRET=replace-with-64-char-random-hex
AIOPS_REQUEST_TIMEOUT=30

# App runtime defaults
# Disable Kint in CLI to keep spark stable
KINT_DISABLED=true
app.enableKint=false
app.baseURL='https://mymiwallet.com/'
# or for dev:
# app.baseURL='http://localhost:8080/'

CI_OPTIMIZE_AUTOLOADER=false

CI_CACHE_CONFIG=false

CI_LOCATOR_CACHE_ENABLED=false

MYMI_ALERT_EMAIL=tradealerts@mymiwallet.com
MYMI_LEGACY_ALERT_EMAIL=alerts@mymiwallet.com

# Dev logging verbosity (numeric CI4 threshold: 9 = all levels)
# logger.threshold = 9

# CSP rollout toggle (set true in staging dry run once audit passes)
CSP_STRICT_MODE=false

# Ollama Control
OLLAMA_MODE=remote
OLLAMA_BASE_URL=https://ollama.timothyburks.com
OLLAMA_INTERNAL_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_CHAT_MODEL=qwen2.5-coder:0.5b
OLLAMA_DEFAULT_EMBED_MODEL=mxbai-embed-large:latest
OLLAMA_TIMEOUT=180
OLLAMA_MAX_TOKENS=100
OLLAMA_GOV_PROFILE=aiops
