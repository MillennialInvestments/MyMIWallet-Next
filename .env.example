#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
# CI_ENVIRONMENT = production
CI_DEBUG = true

# Logging verbosity controls
# Safe default for production-like quiet mode.
LOG_THRESHOLD=emergency,alert,critical,error

# Uncomment for full-spectrum debugging (DEBUG -> EMERGENCY)
# LOG_THRESHOLD=emergency,alert,critical,error,warning,notice,info,debug

# Optional: include warning-level email notifications from DatabaseLoggerHandler
LOGGER_EMAIL_WARNING=false

CSP_STRICT_MODE=false
Config\View.appOverridesFolder = overrides

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.enableKint=false
app.baseURL='https://mymiwallet.com/'
app.indexPage = 'index.php'
app.debug = true
app.debugHUD = true
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# --- Database (DreamHost) ---
database.default.hostname = mysql.mymiwallet.com    # NOT 'localhost'
database.default.database = mymiwallet              # your DB name
database.default.username = mymiteam                # your DB user
database.default.DBDriver = MySQLi
database.default.port = 3306

# Recommended defaults
database.default.charset = utf8mb4
database.default.DBPrefix = ''
database.default.DBDebug = true
database.default.encrypt = false
database.default.persistent = false
database.default.strictOn = false

# Verify MySQL Database Connection
# mysql -h mysql.mymiwallet.com -u mymiteam -p -e "SELECT VERSION();" mymiwallet

# Verify Compiled Adjustments have been applied
# mysql \
#   -h mysql.mymiwallet.com \
#   -u mymiteam \
#   -p \
#   mymiwallet \
#   < writable/db_inventory/compiled_adjustments.sql

#--------------------------------------------------------------------
# EMAIL (SMTP)
#--------------------------------------------------------------------
email.protocol   = smtp
email.smtpHost   = smtp.dreamhost.com
email.smtpPort   = 587
email.smtpCrypto = tls
email.smtpUser   = support@mymiwallet.com
email.fromEmail  = no-reply@mymiwallet.com
email.fromName   = "MyMI Wallet"

# Optional default recipient for `php spark email:test`
test.email.to = tburks2392@gmail.com

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 9

#--------------------------------------------------------------------
# DISCORD INTERNAL API TOKEN

#--------------------------------------------------------------------
# DISCORD_INTERNAL_API_TOKEN="some-long-random-string"

# Toggle N8N AI Integration 
AI_ENABLE_N8N=true
# Toggle Kimi-K2 AI
AI_ENABLE_KIMI_K2=false

AIOPS_AUTOPR_ENABLED=true
AIOPS_BASE_BRANCH=main
AIOPS_BASE_URL=https://aiops.timothyburks.com
AIOPS_CRON_ENABLED=true
AIOPS_ENDPOINT=https://aiops.timothyburks.com/api
# Emergency logging override (CLI/Web/AIOPS): forces all levels including debug/info
AIOPS_FORCE_DEBUG=false
# Github APP ID
AIOPS_GH_APP_ID=2768416
AIOPS_GH_APP_CLIENT_ID=Iv23likmhGGlWhrrbNrm
AIOPS_GITHUB_OWNER=MillennialInvestments
AIOPS_GITHUB_REPO=MyMIWallet-Next
AIOPS_GITHUB_TOKEN=
AIOPS_MODE=remote
AIOPS_PR_LABELS=aiops,autofix
AIOPS_PR_REVIEWERS=
AIOPS_PR_ASSIGNEES=MillennialInvest
AIOPS_REQUEST_TIMEOUT=30

# Internal relay endpoints
AIOPS_PRIMARY_BASE_URL=https://aiops.timothyburks.com
AIOPS_FALLBACK_BASE_URL=https://aiops.mymiwallet.com
AIOPS_INTERNAL_TOKEN=YOUR_SHARED_INTERNAL_TOKEN

# CI_OPTIMIZE_AUTOLOADER=true
# CI_CACHE_CONFIG=true
# CI_LOCATOR_CACHE_ENABLED=true
CI_OPTIMIZE_AUTOLOADER=false
CI_CACHE_CONFIG=false
CI_LOCATOR_CACHE_ENABLED=false

# CSP rollout toggle (set true in staging dry run once audit passes)
CSP_STRICT_MODE=false

