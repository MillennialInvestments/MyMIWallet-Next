{
    "name": "codeigniter4/appstarter",
    "description": "CodeIgniter4 starter app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://codeigniter.com",
    "support": {
        "forum": "https://forum.codeigniter.com/",
        "source": "https://github.com/codeigniter4/CodeIgniter4",
        "slack": "https://codeigniterchat.slack.com"
    },
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.0",
        "erusev/parsedown": "^1.7",
        "guzzlehttp/guzzle": "^7.10",
        "myth/auth": "^1.2",
        "predis/predis": "^3.4",
        "tatter/alerts": "^3.1",
        "tatter/audits": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "kint-php/kint": "^6.0",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Modules\\": "app/Modules"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "app/_legacy/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "build-inventory": "python3 scripts/build_inventory.py",
        "build-seo-inventory": "python3 scripts/build_page_seo_inventory.py",
        "build-sitemap": "python3 scripts/build_sitemap_from_inventory.py",
        "build-syndication-inventory": "python3 scripts/build_syndication_inventory.py",
        "lint:no-route-tokens": "bash scripts/lint_no_route_tokens.sh",
        "lint:csp": "bash scripts/lint_csp.sh",
        "audit:duplicate-classes": "php scripts/check_duplicates.php"
    }
}
