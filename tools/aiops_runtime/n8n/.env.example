# DreamHost n8n runtime configuration (MySQL-backed)
N8N_PORT=8500
N8N_HOST=aiops.mymiwallet.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://aiops.mymiwallet.com/

# Database (DreamHost MySQL)
DB_TYPE=mysqldb
DB_MYSQLDB_HOST=your-dreamhost-mysql-host
DB_MYSQLDB_PORT=3306
DB_MYSQLDB_DATABASE=n8n
DB_MYSQLDB_USER=your-mysql-username
DB_MYSQLDB_PASSWORD=your-mysql-password

# Security
N8N_ENCRYPTION_KEY=replace-with-random-32-byte-key
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-strong-password
