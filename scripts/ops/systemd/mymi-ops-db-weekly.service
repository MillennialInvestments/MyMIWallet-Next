[Unit]
Description=MyMI Wallet weekly ops table maintenance (opt-in)
After=mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/apps/TBI/www/mymiwallet/current
ExecStart=/usr/bin/php spark ops:job:run ops.db.maintenance --allow-db-maintenance
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min
