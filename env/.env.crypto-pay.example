# Crypto Checkout Configuration (.env template)
#
# Crypto checkout is disabled until CRYPTO_PAY_ENABLED=true AND CRYPTO_PAY_NETWORK
# is set to exactly "mainnet" or "testnet".

CRYPTO_PAY_ENABLED=true
CRYPTO_PAY_NETWORK=testnet

# Receiving addresses (public addresses only, never private keys or seeds)
CRYPTO_PAY_EVM_RECIPIENT=0x0000000000000000000000000000000000000000
CRYPTO_PAY_ETHEREUM_RECIPIENT=0x0000000000000000000000000000000000000000
CRYPTO_PAY_BASE_RECIPIENT=0x0000000000000000000000000000000000000000
CRYPTO_PAY_XRPL_RECIPIENT=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CRYPTO_PAY_BITCOIN_RECIPIENT=tb1qXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Keyed RPC endpoints: comma-separated list, tried in order.
# Best practice: place your dedicated/keyed private node first (Alchemy, Infura, QuickNode),
# followed by public fallbacks. If the first fails, subsequent endpoints are tried automatically.
# Example:
# CRYPTO_PAY_ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY,https://ethereum-rpc.publicnode.com
# CRYPTO_PAY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR-API-KEY,https://mainnet.base.org
CRYPTO_PAY_ETHEREUM_RPC=https://ethereum-sepolia-rpc.publicnode.com
CRYPTO_PAY_BASE_RPC=https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com
CRYPTO_PAY_XRPL_RPC=https://s.altnet.rippletest.net:51234
CRYPTO_PAY_BITCOIN_RPC=https://mempool.space/testnet4/api

# Alerts webhook (Discord / AIOps)
# When set, reconcile failures, late payments, underpayments, and endpoint network refusals
# are automatically dispatched to this webhook.
CRYPTO_PAY_ALERT_WEBHOOK=https://discord.com/api/webhooks/...

# Compliance / Sanctions screening
# Enables OFAC/sanctions screening against writable/compliance/sanctions-addresses.txt
COMPLIANCE_SANCTIONS_ENABLED=false
