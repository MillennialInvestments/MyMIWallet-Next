CI=true
CI_ENVIRONMENT=production
ENVIRONMENT=testing
app.baseURL='http://localhost/'
app.enableKint=false
encryption.key='0123456789abcdef0123456789abcdef'

database.default.DBDriver=SQLite3
database.default.database='writable/ci.sqlite'
database.default.DBPrefix=''
database.default.port=0

email.fromEmail='ci@example.com'
email.fromName='CI Runner'
mail.protocol='log'

MYMI_DISABLE_EXTERNAL=1

CI_OPTIMIZE_AUTOLOADER=false

CI_CACHE_CONFIG=false

CI_LOCATOR_CACHE_ENABLED=false

# Ollama Control
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_CHAT_MODEL=llama3.2:latest
OLLAMA_DEFAULT_EMBED_MODEL=mxbai-embed-large:latest
OLLAMA_TIMEOUT=30
OLLAMA_MAX_TOKENS=1200
OLLAMA_GOV_PROFILE=aiops

# AIOPS Control
AIOPS_MODE=remote
AIOPS_BASE_URL=https://aiops.timothyburks.com
AIOPS_APP_KEY=mymiwallet-ci
AIOPS_SHARED_SECRET=ci-placeholder-random-secret
AIOPS_REQUEST_TIMEOUT=10
