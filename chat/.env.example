PORT=8300
BIND_HOST=0.0.0.0

APP_BASE_URL=https://chat.mymiwallet.com

BASIC_AUTH_ACTIVE=true
BASIC_AUTH_USER=team
BASIC_AUTH_PASS=CHANGE_ME

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# Alerts
ALERT_EMAIL_TO=team@mymiwallet.com

# Optional: CI4 webhook to log usage in your main app later
MYMI_USAGE_WEBHOOK_URL=https://mymiwallet.com/API/Management/ingestChatUsage
MYMI_USAGE_WEBHOOK_SECRET=CHANGE_ME
