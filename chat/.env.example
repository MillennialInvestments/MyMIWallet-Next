PORT=8300
BIND_HOST=0.0.0.0
APP_BASE_URL=https://chat.mymiwallet.com
BASIC_AUTH_ACTIVE=true
BASIC_AUTH_USER=team
BASIC_AUTH_PASS=change_me

# Single Sign-On (JWT)
SSO_ENABLED=true
SSO_JWT_ISSUER=https://mymiwallet.com
SSO_JWT_AUDIENCE=chat.mymiwallet.com
SSO_JWT_SECRET=CHANGE_ME

# Database (shared MyMI Wallet MySQL)
DB_HOST=db.mymiwallet.com
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Providers and models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=https://aiops.mymiwallet.com
