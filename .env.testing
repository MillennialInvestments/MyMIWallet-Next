CI=true
CI_ENVIRONMENT = testing
ENVIRONMENT = testing
app.baseURL = 'http://localhost/'

# SQLite-first CI/testing defaults
database.default.DBDriver = SQLite3
database.default.hostname = 127.0.0.1
database.default.database = :memory:
database.default.username = root
database.default.password = ''
database.default.port = 0

MYMI_DISABLE_EXTERNAL = 1

MYMI_ALERT_EMAIL=tradealerts@mymiwallet.com
MYMI_LEGACY_ALERT_EMAIL=alerts@mymiwallet.com

MARKETING_NEWS_IMAP_HOST=imap.dreamhost.com
MARKETING_NEWS_IMAP_PORT=993
MARKETING_NEWS_IMAP_ENCRYPTION=ssl
MARKETING_NEWS_IMAP_USER=tradealerts@mymiwallet.com
MARKETING_NEWS_IMAP_PASS=REAL_PASSWORD_HERE
MARKETING_NEWS_IMAP_MAILBOX=INBOX
MARKETING_NEWS_SUBJECT_FILTER=Press Release
