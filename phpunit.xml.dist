<?xml version="1.0" encoding="UTF-8"?>
<!--
  MYMI-GTM-007: tracked PHPUnit contract for CI.
  Restores the suites that .github/workflows/ci.yml runs (unit and auth-smoke).
  The previous phpunit.xml was removed on 2026-04-20 and both names were
  git-ignored, so phpunit with the unit suite had been printing usage text and
  running zero tests. A local phpunit.xml (git-ignored) overrides this file.
-->
<phpunit bootstrap="tests/_support/bootstrap.php"
         colors="true"
         cacheDirectory="writable/cache/phpunit"
         failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
            <directory suffix="Test.php">tests/feature</directory>
        </testsuite>
        <testsuite name="auth-smoke">
            <directory suffix="Test.php">tests/app/Auth</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="CI_ENVIRONMENT" value="testing"/>
        <server name="ENVIRONMENT" value="testing"/>
    </php>
</phpunit>
