Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If Apache/DreamHost points DocumentRoot to the repository root instead of /public,
    # route requests through /public so CI4 front-controller rewrites still apply.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
